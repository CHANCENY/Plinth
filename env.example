# Choose ONE driver: mysql | postgres | sqlite | mongodb
DB_DRIVER=mysql

# --- mysql / postgres ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_app

# --- sqlite ---
# DB_DRIVER=sqlite
# DB_NAME=storage/database.sqlite   # relative to project root, or an absolute path

# --- mongodb ---
# DB_DRIVER=mongodb
# DB_URI=mongodb://user:password@127.0.0.1:27017/   # preferred: full connection string
# DB_NAME=my_app
# (or, without DB_URI, DatabaseConnection builds one from DB_HOST/DB_PORT/DB_USER/DB_PASSWORD)

# dev server (public/main.py, `python console.py serve`)
APP_HOST=127.0.0.1
APP_PORT=8000

# used to build absolute links in emails (e.g. password reset links)
APP_URL=http://localhost:8000

# Choose ONE driver: smtp | log
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@my_app.com
MAIL_FROM_NAME="My App"

# --- smtp ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls   # tls | ssl | none

# --- log (writes emails to a file instead of sending - handy for local dev) ---
# MAIL_DRIVER=log
# MAIL_LOG_PATH=storage/logs/mail.log   # relative to project root, or an absolute path

# sessions (SessionService) - all optional, shown with their defaults
# SESSION_LIFETIME=7200          # seconds
# SESSION_COOKIE_NAME=session_id

# views (TemplateService) - which public/views/<theme>/ directory to render from by default
THEME_DEFAULT=admin

# password resets (PasswordResetService) - optional, shown with its default
# PASSWORD_RESET_LIFETIME=3600   # seconds

# oauth "social login" (OAuthService/AuthController) - only providers you
# configure (both CLIENT_ID and CLIENT_SECRET set) will be usable; leave a
# provider commented out to hide it from the login/register OAuth buttons.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# MICROSOFT_TENANT=common   # or your Azure AD tenant id, to restrict sign-in to one org
