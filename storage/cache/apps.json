{
  "app_names": [
    "blog"
  ],
  "routes": [
    {
      "path": "/blog/new",
      "method": [
        "GET",
        "POST"
      ],
      "controller": "public.apps.blog.controllers.PostController::create",
      "permission": [
        "*"
      ],
      "app": "blog"
    },
    {
      "path": "/blog",
      "method": [
        "GET"
      ],
      "controller": "public.apps.blog.controllers.PostController::index",
      "permission": [
        "*"
      ],
      "app": "blog"
    },
    {
      "path": "/blog/<slug>",
      "method": [
        "GET"
      ],
      "controller": "public.apps.blog.controllers.PostController::show",
      "permission": [
        "*"
      ],
      "app": "blog"
    }
  ],
  "models": [
    "public.apps.blog.models.Post:Post"
  ],
  "warnings": []
}