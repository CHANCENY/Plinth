# Choose ONE driver: mysql | postgres | sqlite | mongodb
DB_DRIVER=mysql

# --- mysql / postgres ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_app

# --- sqlite ---
# DB_DRIVER=sqlite
# DB_NAME=storage/database.sqlite   # relative to project root, or an absolute path

# --- mongodb ---
# DB_DRIVER=mongodb
# DB_URI=mongodb://user:password@127.0.0.1:27017/   # preferred: full connection string
# DB_NAME=my_app
# (or, without DB_URI, DatabaseConnection builds one from DB_HOST/DB_PORT/DB_USER/DB_PASSWORD)

# dev server (public/main.py, `python console.py serve`)
APP_HOST=127.0.0.1
APP_PORT=8000

# used to build absolute links in emails (e.g. password reset links)
APP_URL=http://localhost:8000

# Choose ONE driver: smtp | log
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@my_app.com
MAIL_FROM_NAME="My App"

# --- smtp ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls   # tls | ssl | none

# --- log (writes emails to a file instead of sending - handy for local dev) ---
# MAIL_DRIVER=log
# MAIL_LOG_PATH=storage/logs/mail.log   # relative to project root, or an absolute path

# sessions (SessionService) - all optional, shown with their defaults
# SESSION_LIFETIME=7200          # seconds
# SESSION_COOKIE_NAME=session_id

# views (TemplateService) - the built-in admin app renders from its own views/ directory
# ("admin:..." view names), so no theme is needed for it. Only set this if you add a
# public/views/<theme>/ directory and render un-prefixed view names from it.
# THEME_DEFAULT=default

# public API access / CORS (CorsService) - lets pages on OTHER sites call this one from the browser.
# Off by default: nothing changes until PUBLIC_API_ENABLED=true. Apps then do their own authentication
# (e.g. a token in the Authorization header); cookies are never sent cross-origin.
# PUBLIC_API_ENABLED=false
# PUBLIC_API_ALLOWED_ORIGINS=*                # "*" = any site, or a comma list: https://app.example.com,https://admin.example.com
# PUBLIC_API_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
# PUBLIC_API_ALLOWED_HEADERS=*                # "*" = whatever the browser asks for, or a list: Authorization,Content-Type
# PUBLIC_API_EXPOSE_HEADERS=                  # response headers scripts may read, e.g. X-Total-Count
# PUBLIC_API_MAX_AGE=86400                    # seconds a browser may cache a preflight answer

# API authentication (the optional "apiauth" app - register it in app.py to use it). All optional.
# API_AUTH_SCHEMES=apikey,bearer              # apikey, bearer, jwt, basic, hmac - which ways of authenticating are accepted
# API_AUTH_SECRET=                            # 32+ random characters; REQUIRED for jwt and hmac:
#                                             #   python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_AUTH_GRANTS=password,client_credentials,refresh_token
# API_AUTH_TOKEN_FORMAT=opaque                # what the token endpoint issues: opaque or jwt
# API_AUTH_ACCESS_TTL=3600                    # access token lifetime, seconds
# API_AUTH_REFRESH_TTL=2592000                # refresh token lifetime, seconds (30 days)
# API_AUTH_ISSUER=                            # the "iss" of issued JWTs (default: APP_URL, or "plinth")
# API_AUTH_JWT_CHECK_REVOCATION=true          # false = fully stateless JWTs (valid until they expire)
# API_AUTH_HMAC_TOLERANCE=300                 # how far a signed request's timestamp may be from the server clock, seconds
# API_AUTH_BASIC_PASSWORDS=false              # allow account email + password over HTTP Basic (off: it sends the password every time)
# API_AUTH_MAX_FAILURES=10                    # failed attempts per client + identity before 429 ...
# API_AUTH_FAILURE_WINDOW=900                 # ... within this many seconds

# Fake data in the dashboard (the optional "fakedata" app - register it in app.py). The command line
# (python console.py fake:generate ...) works without this. OFF by default: it writes junk into your database,
# so enable it only on a development machine.
# FAKE_DATA_ENABLED=false

# media library (MediaService) and file storage (StorageService) - all optional, shown with their defaults
# MEDIA_MAX_UPLOAD_MB=10                      # largest single upload (a request body is also capped at 50 MB)
# MEDIA_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,pdf   # narrows the built-in list of image/document/audio/video types
# STORAGE_PUBLIC_PATH=public/uploads          # web-accessible disk, served by the app at /uploads/...
# STORAGE_PRIVATE_PATH=storage/app            # not web-accessible

# password resets (PasswordResetService) - optional, shown with its default
# PASSWORD_RESET_LIFETIME=3600   # seconds

# oauth "social login" (OAuthService/AuthController) - only providers you
# configure (both CLIENT_ID and CLIENT_SECRET set) will be usable; leave a
# provider commented out to hide it from the login/register OAuth buttons.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
# MICROSOFT_TENANT=common   # or your Azure AD tenant id, to restrict sign-in to one org
